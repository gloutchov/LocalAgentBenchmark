{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localagent-benchmark.invalid/schemas/dashboard-data.schema.json",
  "title": "LocalAgent Benchmark dashboard dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_order", "runs", "funnel"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3]},
    "profile_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/run"}
    },
    "funnel": {
      "type": "array",
      "items": {"$ref": "#/$defs/funnelStage"}
    }
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"], "minimum": 0},
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_schema_version", "report_schema_version", "run_sha256", "report_sha256", "repository_commit"],
      "properties": {
        "run_schema_version": {"enum": [2, 3, 4]},
        "report_schema_version": {"enum": [2, 3, 4]},
        "run_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "repository_commit": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "enforced", "filesystem_isolation", "process_isolation", "network_isolation"],
      "properties": {
        "backend": {"type": "string", "minLength": 1, "maxLength": 64},
        "enforced": {"type": "boolean"},
        "filesystem_isolation": {"type": "boolean"},
        "process_isolation": {"type": "boolean"},
        "network_isolation": {"type": "boolean"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "disqualified_models"],
      "properties": {
        "status": {"type": "string", "minLength": 1, "maxLength": 64},
        "disqualified_models": {"$ref": "#/$defs/stringList"}
      }
    },
    "thinkingControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "requested", "reasoning_effort", "source"],
      "properties": {
        "version": {"type": "integer", "minimum": 0},
        "status": {"type": "string", "minLength": 1, "maxLength": 64},
        "requested": {"type": "string", "minLength": 1, "maxLength": 32},
        "reasoning_effort": {"type": ["string", "null"], "maxLength": 32},
        "source": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reason", "case_id"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "reason": {"enum": ["thinking_observed_off", "thinking_unverified", "workspace_boundary", "repository_mutation", "snapshot_mutation", "integrity_other"]},
        "case_id": {"type": ["string", "null"], "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}
      }
    },
    "leaderboardRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "model", "overall_score", "quality_score", "completion_rate", "speed_score", "token_efficiency_score", "median_duration_seconds", "median_output_tokens", "median_cpu_seconds", "median_energy_joules", "score_stddev", "successful_tasks", "total_tasks", "case_scores"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "overall_score": {"$ref": "#/$defs/nullableNumber"},
        "quality_score": {"$ref": "#/$defs/nullableNumber"},
        "completion_rate": {"$ref": "#/$defs/nullableNumber"},
        "speed_score": {"$ref": "#/$defs/nullableNumber"},
        "token_efficiency_score": {"$ref": "#/$defs/nullableNumber"},
        "median_duration_seconds": {"$ref": "#/$defs/nullableNumber"},
        "median_output_tokens": {"$ref": "#/$defs/nullableNumber"},
        "median_cpu_seconds": {"$ref": "#/$defs/nullableNumber"},
        "median_energy_joules": {"$ref": "#/$defs/nullableNumber"},
        "score_stddev": {"$ref": "#/$defs/nullableNumber"},
        "successful_tasks": {"type": ["integer", "null"], "minimum": 0},
        "total_tasks": {"type": ["integer", "null"], "minimum": 0},
        "case_scores": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "case_id", "case_title", "case_title_en", "category", "repetition", "status", "state", "score", "max_score", "duration_seconds", "output_tokens", "tool_calls", "tool_errors", "cpu_seconds", "energy_joules", "integrity_valid"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "case_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "case_title": {"type": "string", "minLength": 1, "maxLength": 200},
        "case_title_en": {"type": "string", "minLength": 1, "maxLength": 200},
        "category": {"type": "string", "minLength": 1, "maxLength": 64},
        "repetition": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "minLength": 1, "maxLength": 32},
        "state": {"enum": ["passed", "below_threshold", "timeout", "error", "missing_score", "integrity_excluded"]},
        "score": {"$ref": "#/$defs/nullableNumber"},
        "max_score": {"$ref": "#/$defs/nullableNumber"},
        "duration_seconds": {"$ref": "#/$defs/nullableNumber"},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "tool_errors": {"type": ["integer", "null"], "minimum": 0},
        "cpu_seconds": {"$ref": "#/$defs/nullableNumber"},
        "energy_joules": {"$ref": "#/$defs/nullableNumber"},
        "integrity_valid": {"type": ["boolean", "null"]}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "benchmark_version", "started_at", "finished_at", "provenance", "sandbox", "integrity", "participants", "leaderboard", "tasks"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 120},
        "profile": {"type": "string", "minLength": 1, "maxLength": 64},
        "benchmark_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "started_at": {"type": ["string", "null"], "maxLength": 64},
        "finished_at": {"type": ["string", "null"], "maxLength": 64},
        "provenance": {"$ref": "#/$defs/provenance"},
        "sandbox": {"$ref": "#/$defs/sandbox"},
        "integrity": {"$ref": "#/$defs/integrity"},
        "thinking_control": {"$ref": "#/$defs/thinkingControl"},
        "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}},
        "participants": {"$ref": "#/$defs/stringList"},
        "leaderboard": {"type": "array", "items": {"$ref": "#/$defs/leaderboardRow"}},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
      }
    },
    "funnelStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "run_ids", "participants", "new_participants", "next_profile", "continued_to_next", "not_run_in_next"],
      "properties": {
        "profile": {"type": "string", "minLength": 1, "maxLength": 64},
        "run_ids": {"$ref": "#/$defs/stringList"},
        "participants": {"$ref": "#/$defs/stringList"},
        "new_participants": {"$ref": "#/$defs/stringList"},
        "next_profile": {"type": ["string", "null"], "maxLength": 64},
        "continued_to_next": {"$ref": "#/$defs/stringList"},
        "not_run_in_next": {"$ref": "#/$defs/stringList"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"enum": [2, 3]}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "runs": {
            "items": {"required": ["thinking_control"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 3}}, "required": ["schema_version"]},
      "then": {"properties": {"runs": {"items": {"required": ["thinking_control", "exclusions"]}}}}
    }
  ]
}
