{
  "version": 1,
  "ollama": {
    "url": "http://127.0.0.1:11434"
  },
  "pi": {
    "command": ["pi"]
  },
  "models": "installed",
  "defaults": {
    "timeout_seconds": 1200,
    "repetitions": 1,
    "thinking": "off",
    "thinking_preflight_timeout_seconds": 300,
    "pi_contract_timeout_seconds": 30,
    "http_idle_timeout_ms": 0,
    "agent_max_retries": 0,
    "provider_max_retries": 0,
    "warmup": true,
    "keep_alive": "15m",
    "context_window": 32768,
    "max_tokens": 8192,
    "temperature": 0,
    "sandbox": "audit"
  },
  "dashboard": {
    "assets_directory": "dashboard",
    "results_directory": "results",
    "snapshot_source": "cases/results_dashboard/fixture/dashboard-data.json",
    "host": "127.0.0.1",
    "port": 0,
    "open_browser": true
  },
  "guided": {
    "profiles": ["smoke", "standard", "full"],
    "promotion_limits": [4, 2],
    "preferences_file": ".localagent-benchmark/guided-preferences.json"
  },
  "profiles": {
    "smoke": ["targeted_patch"],
    "standard": ["targeted_patch", "secure_workspace", "config_i18n", "thinking_challenge"],
    "full": ["targeted_patch", "secure_workspace", "config_i18n", "thinking_challenge", "milestone_closure"],
    "thinking": ["thinking_challenge"],
    "showcase": ["results_dashboard"]
  },
  "cases": {
    "directory": "cases"
  }
}
